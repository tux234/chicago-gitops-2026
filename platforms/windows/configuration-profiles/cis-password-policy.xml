<!--
  CIS Microsoft Windows 11 Enterprise Benchmark, section 1: Account Policies (password policy and account lockout).
  These DeviceLock nodes map 1:1 to the Group Policy "Account Policies" settings and apply to local accounts.
  They need Windows 11 24H2 (10.0.26100), or 22H2 with KB5053657 (10.0.22621.5126). Older builds report this profile as Failed.
  Policy CSP DeviceLock: https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-devicelock
  The legacy Exchange ActiveSync DeviceLock nodes (DevicePasswordEnabled, MinDevicePasswordLength, ...) are intentionally not used:
  applying them marks every local account to change its password at next sign-in, and MaxDevicePasswordFailedAttempts
  sends a desktop to BitLocker recovery instead of locking the account.
-->
<Replace>
  <!-- Enforce password history = 24 passwords -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/PasswordHistorySize</LocURI>
    </Target>
    <Data>24</Data>
  </Item>
</Replace>
<Replace>
  <!-- Maximum password age = 365 days (not 0) -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/MaximumPasswordAge</LocURI>
    </Target>
    <Data>365</Data>
  </Item>
</Replace>
<Replace>
  <!-- Minimum password age = 1 day -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/MinimumPasswordAge</LocURI>
    </Target>
    <Data>1</Data>
  </Item>
</Replace>
<Replace>
  <!-- Relax minimum password length limits = Enabled (allows lengths above 14 later) -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/RelaxMinimumPasswordLengthLimits</LocURI>
    </Target>
    <Data>1</Data>
  </Item>
</Replace>
<Replace>
  <!-- Minimum password length = 14 characters -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/MinimumPasswordLength</LocURI>
    </Target>
    <Data>14</Data>
  </Item>
</Replace>
<Replace>
  <!-- Password must meet complexity requirements = Enabled -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/PasswordComplexity</LocURI>
    </Target>
    <Data>1</Data>
  </Item>
</Replace>
<Replace>
  <!-- Store passwords using reversible encryption = Disabled -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/ClearTextPassword</LocURI>
    </Target>
    <Data>0</Data>
  </Item>
</Replace>
<Replace>
  <!-- Account lockout duration = 15 minutes, threshold = 5 attempts, reset counter after = 15 minutes -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/AccountLockoutPolicy</LocURI>
    </Target>
    <Data>AccountLockoutDuration:15, AccountLockoutThreshold:5, ResetAccountLockoutCounterAfter:15</Data>
  </Item>
</Replace>
<Replace>
  <!-- Allow Administrator account lockout = Enabled -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/AllowAdministratorLockout</LocURI>
    </Target>
    <Data>1</Data>
  </Item>
</Replace>
