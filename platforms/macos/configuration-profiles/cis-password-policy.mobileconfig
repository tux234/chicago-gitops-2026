<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadDescription</key>
	<string>CIS Apple macOS 26 Tahoe Benchmark v1.1.0, section 5.2 Password Management, Level 2: 5.2.1 lockout threshold, 5.2.2 minimum length, 5.2.3 alphabetic, 5.2.4 numeric, 5.2.5 special character, 5.2.6 upper and lower case, 5.2.7 password age, 5.2.8 password history. Values follow the mSCP cis_lvl2 baseline.</string>
	<key>PayloadDisplayName</key>
	<string>CIS - Password policy</string>
	<key>PayloadEnabled</key>
	<true/>
	<key>PayloadIdentifier</key>
	<string>com.chicagogitops2026.cis.password-policy</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>B9776161-E65D-43D9-9626-E653397E598A</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadRemovalDisallowed</key>
	<true/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDescription</key>
			<string>Local account password complexity, age, history, and lockout.</string>
			<key>PayloadDisplayName</key>
			<string>Passcode</string>
			<key>PayloadEnabled</key>
			<true/>
			<key>PayloadIdentifier</key>
			<string>com.chicagogitops2026.cis.password-policy.96E0868E-F728-4876-939B-50629D4C1EF2</string>
			<key>PayloadType</key>
			<string>com.apple.mobiledevice.passwordpolicy</string>
			<key>PayloadUUID</key>
			<string>96E0868E-F728-4876-939B-50629D4C1EF2</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<!-- 5.2.1: lock the account after 5 failed attempts -->
			<key>maxFailedAttempts</key>
			<integer>5</integer>
			<!-- Not a CIS 5.2.1 requirement: unlock after 15 minutes (mSCP pwpolicy_account_lockout_timeout_enforce) so locked-out users are not stranded -->
			<key>minutesUntilFailedLoginReset</key>
			<integer>15</integer>
			<!-- 5.2.2: at least 15 characters -->
			<key>minLength</key>
			<integer>15</integer>
			<!-- 5.2.3 and 5.2.4: at least one letter and one number -->
			<key>requireAlphanumeric</key>
			<true/>
			<!-- 5.2.5: at least one special (non-alphanumeric) character -->
			<key>minComplexChars</key>
			<integer>1</integer>
			<!-- 5.2.6: at least one uppercase and one lowercase letter (mSCP cis_lvl2 value) -->
			<key>customRegex</key>
			<dict>
				<key>passwordContentRegex</key>
				<string>^(?=.*[A-Z])(?=.*[a-z]).*$</string>
				<key>passwordContentDescription</key>
				<dict>
					<key>default</key>
					<string>Password must contain at least one uppercase and one lowercase letter.</string>
				</dict>
			</dict>
			<!-- 5.2.7: expire passwords after 365 days -->
			<key>maxPINAgeInDays</key>
			<integer>365</integer>
			<!-- 5.2.8: remember the last 24 passwords -->
			<key>pinHistory</key>
			<integer>24</integer>
		</dict>
	</array>
</dict>
</plist>
